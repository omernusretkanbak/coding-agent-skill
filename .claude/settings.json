      "Bash(git rev-parse *)", "PowerShell(git rev-parse *)",
      "Bash(git check-ignore *)", "PowerShell(git check-ignore *)",
      "Bash(git worktree *)", "PowerShell(git worktree *)",
      "Bash(git switch *)", "PowerShell(git switch *)",
      "Bash(git fetch *)", "PowerShell(git fetch *)",
      "Bash(git stash *)", "PowerShell(git stash *)",
      "Bash(git add *)", "PowerShell(git add *)",
      "Bash(git commit *)", "PowerShell(git commit *)",
      "Bash(git push *)", "PowerShell(git push *)",
      "Bash(gh pr create *)", "PowerShell(gh pr create *)",
      "Bash(gh pr view *)", "PowerShell(gh pr view *)",
      "Bash(gh pr diff *)", "PowerShell(gh pr diff *)",
      "Bash(gh pr list *)", "PowerShell(gh pr list *)",
